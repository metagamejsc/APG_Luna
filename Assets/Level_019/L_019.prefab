--- !u!114 &3452550713091102325
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6574827184574475938}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e5d7bfc1c2f93374490868acbdad2869, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  onEnter:
    m_PersistentCalls:
      m_Calls: []
  onExit:
    m_PersistentCalls:
      m_Calls: []
  singleHintAction: {fileID: 0}
  hintedAction: 1
  hintEng: Tap The Slot Machine Lever and Swipe Down.
  hintVi: "Ch\u1EA1m v\xE0o C\u1EA7n G\u1EA1t c\u1EE7a M\xE1y K\xE9o X\xE8ng r\u1ED3i
    Vu\u1ED1t Xu\u1ED1ng."
  hintSp: "Toca la palanca de la m\xE1quina tragaperras y desliza hacia abajo."
  hintFr: "Appuie sur le levier de la machine \xE0 sous et fais glisser vers le bas."
  hintJa: "\u30B9\u30ED\u30C3\u30C8\u30DE\u30B7\u30F3\u306E\u30EC\u30D0\u30FC\u3092\u30BF\u30C3\u30D7\u3057\u3066\u4E0B\u306B\u30B9\u30EF\u30A4\u30D7\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  hintKo: "\uC2AC\uB86F\uBA38\uC2E0\uC758 \uB808\uBC84\uB97C \uD130\uCE58\uD558\uACE0
    \uC544\uB798\uB85C \uC2A4\uC640\uC774\uD504\uD558\uC138\uC694."
  hintTh: "\u0E41\u0E15\u0E30\u0E04\u0E31\u0E19\u0E42\u0E22\u0E01\u0E02\u0E2D\u0E07\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E2A\u0E25\u0E47\u0E2D\u0E15\u0E41\u0E25\u0E49\u0E27\u0E1B\u0E31\u0E14\u0E25\u0E07"
  hintCh: "\u70B9\u51FB\u8001\u864E\u673A\u7684\u62C9\u6746\u5E76\u5411\u4E0B\u6ED1\u52A8\u3002"
  hintPo: "Toque na alavanca da m\xE1quina ca\xE7a-n\xEDqueis e deslize para baixo."
  hintGe: Tippe auf den Hebel des Spielautomaten und wische nach unten.
  hintIt: Tocca la leva della slot machine e scorri verso il basso.
  hintIn: Sentuh tuas mesin slot lalu geser ke bawah.
  hintTu: "Slot makinesinin koluna dokun ve a\u015Fa\u011F\u0131 kayd\u0131r."
  hintHi: "\u0938\u094D\u0932\u0949\u091F \u092E\u0936\u0940\u0928 \u0915\u0947 \u0932\u0940\u0935\u0930
    \u0915\u094B \u091B\u0942\u0915\u0930 \u0928\u0940\u091A\u0947 \u0915\u0940 \u0913\u0930
    \u0938\u094D\u0935\u093E\u0907\u092A \u0915\u0930\u094B\u0964"
  hintAr: "\u0627\u0644\u0645\u0633 \u0630\u0631\u0627\u0639 \u0622\u0644\u0629 \u0627\u0644\u0642\u0645\u0627\u0631
    \u0648\u0627\u0633\u062D\u0628 \u0644\u0644\u0623\u0633\u0641\u0644."
  hintRu: "\u041A\u043E\u0441\u043D\u0438\u0441\u044C \u0440\u044B\u0447\u0430\u0433\u0430
    \u0438\u0433\u0440\u043E\u0432\u043E\u0433\u043E \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430
    \u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0438 \u0432\u043D\u0438\u0437.\r"
  skipAction: 0
  startArea: {fileID: 7639668818388372137}
  swipeDirection: 3
  ignoreUI: 0
  progress: 1
