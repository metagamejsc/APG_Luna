  m_Script: {fileID: 11500000, guid: 50a7cb824436a45459c2d4963e9e9997, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  timeline: {fileID: 2280265567700229967}
  playTime: 300
  titleVi: "Gi\xFAp anh \u1EA5y thanh to\xE1n h\u1EBFt n\u1EE3"
  titleEn: Help him pay off all his debts
  titleSp: "Ay\xFAdalo a pagar todas sus deudas"
  titleFr: "Aide-le \xE0 rembourser toutes ses dettes"
  titleJa: "\u5F7C\u304C\u501F\u91D1\u3092\u3059\u3079\u3066\u8FD4\u6E08\u3059\u308B\u306E\u3092\u52A9\u3051\u3066"
  titleKr: "\uADF8\uAC00 \uBAA8\uB4E0 \uBE5A\uC744 \uAC1A\uB3C4\uB85D \uB3C4\uC640\uC918"
  titleTh: "\u0E0A\u0E48\u0E27\u0E22\u0E43\u0E2B\u0E49\u0E40\u0E02\u0E32\u0E43\u0E0A\u0E49\u0E2B\u0E19\u0E35\u0E49\u0E08\u0E19\u0E2B\u0E21\u0E14"
  titleCh: "\u5E2E\u52A9\u4ED6\u8FD8\u6E05\u6240\u6709\u503A\u52A1"
  titlePo: "Ajude-o a pagar todas as d\xEDvidas"
  titleGe: Hilf ihm, alle Schulden zu begleichen
  titleIt: Aiutalo a saldare tutti i debiti
  titleIn: Bantu dia melunasi semua utangnya
  titleTu: "Onun t\xFCm bor\xE7lar\u0131n\u0131 \xF6demesine yard\u0131m et"
  titleHi: "\u0909\u0938\u0947 \u0938\u093E\u0930\u093E \u0915\u0930\u094D\u091C
    \u091A\u0941\u0915\u093E\u0928\u0947 \u092E\u0947\u0902 \u092E\u0926\u0926 \u0915\u0930\u094B"
  titleAr: "\u0633\u0627\u0639\u062F\u0647 \u0639\u0644\u0649 \u0633\u062F\u0627\u062F
    \u062C\u0645\u064A\u0639 \u062F\u064A\u0648\u0646\u0647"
  titleRu: "\u041F\u043E\u043C\u043E\u0433\u0438 \u0435\u043C\u0443 \u043F\u043E\u0433\u0430\u0441\u0438\u0442\u044C
    \u0432\u0441\u0435 \u0434\u043E\u043B\u0433\u0438"
  visualHint: 0
  intro: 1
