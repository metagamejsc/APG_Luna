  maxStep: 12
  currentStepText: {fileID: 1664803801}
  maxStepText: {fileID: 1324164032}
  slider: {fileID: 756495695}
  DelayComplete: 3
  subTime: 2
  completeSub:
    Item: {fileID: 0}
    SubText: "Oh my gosh, she\u2019s so beautiful!"
    SubSound: {fileID: 8300000, guid: 6f8289496faed4f4d91d356736a8fafa, type: 3}
  subs:
  - Item: {fileID: 547499107}
    SubText: Using a rope to slim the body
    SubSound: {fileID: 8300000, guid: c217175706573a84080c7da634275405, type: 3}
  - Item: {fileID: 792213225}
    SubText: A bow makes me look adorable
    SubSound: {fileID: 8300000, guid: d97691a34775e3949ad4a84e318fb6fc, type: 3}
  - Item: {fileID: 763144072}
    SubText: Covering imperfections with makeup
    SubSound: {fileID: 8300000, guid: 7004d04e67fed424a9fbcf5296834e64, type: 3}
  - Item: {fileID: 535974963}
    SubText: A little perfume gets rid of the bad smell
    SubSound: {fileID: 8300000, guid: b6e770c0b8eeadd4c982efde3c547f9e, type: 3}
  - Item: {fileID: 1459825998}
    SubText: "Let\u2019s tidy up my hair"
    SubSound: {fileID: 8300000, guid: a0b4515e61eb3b44791c57fca40b0b4f, type: 3}
  - Item: {fileID: 248325035}
    SubText: Painful punches, but necessary to reduce my face fat
    SubSound: {fileID: 8300000, guid: 44854e4aa9b5c22479a9ec8ab4617d3a, type: 3}
  - Item: {fileID: 838372253}
    SubText: Time to change this dirty shirt
    SubSound: {fileID: 8300000, guid: 9aa49b2aa69873447aeb961a46e6bd13, type: 3}
  - Item: {fileID: 1641008635}
    SubText: I need a pair of socks
    SubSound: {fileID: 8300000, guid: fe3d09e06b3947342bbe33d5d0623e0d, type: 3}
  - Item: {fileID: 1457180715}
    SubText: Say goodbye to my leg hair
    SubSound: {fileID: 8300000, guid: 32f53ab9663cd8045bfb2cfd6c80601d, type: 3}
  - Item: {fileID: 2015541044}
    SubText: The glasses are hiding my face
    SubSound: {fileID: 8300000, guid: 63ec46253d7c4d14480a5b9d4d4ae148, type: 3}
  sub: {fileID: 1529613735}
  subText: {fileID: 1113131158}
